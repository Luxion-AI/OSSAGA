APP_NAME=OSSAGA
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
# Railway injects DATABASE_URL automatically when attaching Postgres plugin.
# You can also set individual vars for local development:
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=ossaga
DB_USERNAME=postgres
DB_PASSWORD=secret
DB_SSLMODE=prefer

BROADCAST_DRIVER=log
CACHE_STORE=database
FILESYSTEM_DISK=s3
QUEUE_CONNECTION=sync
SESSION_DRIVER=database
SESSION_LIFETIME=120

# Cloudflare R2 / S3 Configuration
AWS_ACCESS_KEY_ID=your_cloudflare_access_key
AWS_SECRET_ACCESS_KEY=your_cloudflare_secret_key
AWS_DEFAULT_REGION=auto
AWS_BUCKET=ossaga-bucket
AWS_USE_PATH_STYLE_ENDPOINT=false
AWS_ENDPOINT=https://<YOUR_ACCOUNT_ID>.r2.cloudflarestorage.com
AWS_URL=https://pub-<random_hash>.r2.dev

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

OCTANE_SERVER=frankenphp
OCTANE_HTTPS=false
